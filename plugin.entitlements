<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime denies camera-class devices (an iPhone over USB is
	     one, per ImageCaptureCore) without this — the browser then lists
	     nothing, silently. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
